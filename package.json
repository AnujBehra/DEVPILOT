{
  "name": "devpilot",
  "version": "1.0.0",
  "description": "Production-ready DevOps project management and observability platform.",
  "main": "index.js",
  "scripts": {
    "start": "DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot npm --prefix apps/api-gateway start",
    "local": "bash scripts/start-local.sh",
    "dev": "npm --prefix apps/frontend run dev",
    "dev:api": "DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot npm --prefix apps/api-gateway start",
    "build": "npm --prefix apps/api-gateway run build && npm --prefix apps/frontend run build",
    "build:api": "npm --prefix apps/api-gateway run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "seed": "DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot npm --prefix apps/api-gateway run seed",
    "postgres:up": "docker compose up -d postgres",
    "postgres:seed": "DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot npm --prefix apps/api-gateway run seed:public",
    "dev:api:postgres": "DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot npm --prefix apps/api-gateway start",
    "monitoring": "docker compose -f docker-compose.monitoring.yml up",
    "monitoring:grafana-cloud": "bash scripts/configure_grafana_cloud.sh",
    "verify": "npm run build && docker compose config >/dev/null && docker compose -f docker-compose.monitoring.yml config >/dev/null",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.10.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.8",
    "@types/jest": "^26.0.20",
    "@types/node": "^14.14.31",
    "jest": "^26.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/devpilot-ai.git"
  },
  "keywords": [
    "devops",
    "project management",
    "saas",
    "observability",
    "prometheus",
    "grafana"
  ],
  "author": "DevPilot Project Team",
  "license": "MIT"
}
