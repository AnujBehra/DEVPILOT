# DevPilot API Gateway
NODE_ENV=development
PORT=3010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=2000
PROJECT_HEALTH_CHECK_INTERVAL_MS=30000
CHECK_PROJECTS_ON_METRICS=true

# Persistence
# PostgreSQL is required. The API will not start without DATABASE_URL.
# Vercel must have DATABASE_URL set to a hosted PostgreSQL database.
DATABASE_URL=postgres://devpilot:devpilot@localhost:5432/devpilot
DEVPILOT_WORKSPACE_ID=my-software-team
DEVPILOT_WORKSPACE_NAME=DevPilot Team Space

# Scheduled jobs and deployment providers
CRON_SECRET=change-me-for-production
GITHUB_TOKEN=
GITLAB_TOKEN=

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Grafana Cloud remote write, optional
GRAFANA_CLOUD_STACK_URL=
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_API_TOKEN=

# SaaS tenant and alert integrations
DEVPILOT_TENANT_NAME=Xorism
DEVPILOT_TENANT_DOMAIN=xorism.local
DEVPILOT_REGION=ap-south-1
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:3010
VITE_API_TIMEOUT_MS=12000
VITE_OPEN_GRAFANA_URL=
VITE_OPEN_GRAFANA_DASHBOARD_URL=
