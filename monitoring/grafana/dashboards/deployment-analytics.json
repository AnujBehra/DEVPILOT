{
  "uid": "devpilot-deployment-analytics",
  "title": "Deployment Analytics",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Total Deployments",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "deployments_created_total",
          "legendFormat": "deployments",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Deployment Rate",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(deployments_created_total[5m])",
          "legendFormat": "deployments/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Deployments By Status",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (deployment_status_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Deployment Rate",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(deployment_status_total{status=~\"Failed|Rolled Back\"}[5m]))",
          "legendFormat": "failed/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Deployments By Provider",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (provider) (deployment_status_total)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Incident Creation Rate",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(incidents_created_total[5m])",
          "legendFormat": "incidents/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Incidents By Severity",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (severity, status) (incident_severity_total)",
          "legendFormat": "{{severity}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
